{
  "name": "meu-treino-dev",
  "private": true,
  "description": "Meu Treino development tools (browser tests). The app uses nothing from here: it runs straight from the files.",
  "scripts": {
    "test": "node --test tests/",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report tests/e2e/report",
    "test:e2e:coverage": "node tools/e2e-coverage.js --verbose"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
